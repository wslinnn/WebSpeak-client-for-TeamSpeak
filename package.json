{
  "name": "webspeak-webclient",
  "version": "0.2.6",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "description": "Server-side browser gateway for TeamSpeak — deploy on your server, users join from any browser",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "test": "node scripts/run-tests.mjs",
    "verify": "npm run lint && npm test && npm run build && npm run web:lint && npm run web:build",
    "start": "node dist/index.js",
    "web:dev": "cd web && npx vite --host",
    "web:build": "npm --prefix web run build",
    "lint": "eslint .",
    "web:lint": "npm --prefix web run lint"
  },
  "dependencies": {
    "@discordjs/opus": "^0.10.0",
    "@echosixhiya/teamspeak-client": "file:vendor/teamspeak-client",
    "compression": "^1.8.2",
    "express": "^5.2.1",
    "pino": "^10.3.1",
    "werift": "0.24.4",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.0",
    "@types/ws": "^8.18.1",
    "eslint": "^9.39.4",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.71.1"
  },
  "overrides": {
    "body-parser": "^2.3.0",
    "esbuild": "^0.28.2",
    "tar": "^7.5.22"
  }
}
